<Equipment>

<!-- Makiatto Skins -->

    <Bind eqp="GFL_SKIN_WA2000_DEFAULT">
        <to name="GFL-DOLL-WA2000" />
    </Bind>
    <Scope name="GFL_SKIN_WA2000_DEFAULT" inventoryBinding="Custom1"
        tooltip="@skin_wa2000_default_name"
        description="@skin_wa2000_default_desc"
        img="data/models/dolls/skins/wa2000/skin0_ui.dds"
    >
        <RenderObject3D
            model="data/models/dolls/wa2000.khm"
            diffuseTex="data/models/dolls/wa2000.dds"
        />
    </Scope>

    <Bind eqp="GFL_SKIN_WA2000_SKIN1">
        <to name="GFL-DOLL-WA2000" />
    </Bind>
    <Scope name="GFL_SKIN_WA2000_SKIN1" inventoryBinding="Custom1"
        tooltip="@skin_wa2000_skin1_name"
        description="@skin_wa2000_skin1_desc"
        img="data/models/dolls/skins/wa2000/skin1_ui.dds"
    >
        <RenderObject3D
            model="data/models/dolls/skins/wa2000/skin1.khm"
            diffuseTex="data/models/dolls/skins/wa2000/skin1.dds"
        />
    </Scope>

</Equipment>
